# Copy to .env and fill in. Never commit .env.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Optional: comma-separated Telegram user IDs allowed to use the bot.
# Leave empty for an open bot (anyone who DMs it can use it).
# To find your numeric ID, DM @userinfobot on Telegram.
# Example: TELEGRAM_ALLOWED_USER_IDS=12345678,98765432
TELEGRAM_ALLOWED_USER_IDS=

# --- Public base URL of this backend (used for Telegram webhook and OAuth callback) ---
PUBLIC_BASE_URL=https://example.com

# --- Splitwise OAuth 2.0 ---
# Register at https://secure.splitwise.com/oauth_clients
SPLITWISE_CLIENT_ID=
SPLITWISE_CLIENT_SECRET=

# --- AI providers ---
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional: override the Gemini model. Useful if the default isn't in
# the free tier on your Cloud project. Try gemini-2.5-flash, gemini-flash-lite,
# or check https://ai.dev/rate-limit to see what your project has access to.
GEMINI_MODEL=

# --- Supabase (Postgres + Storage) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres URI from Supabase dashboard → Project Settings → Database
# → Connection string. Only needed locally when running scripts/migrate.py.
# If left empty, migrate.py builds the URL from SUPABASE_URL + POSTGRES_PASSWORD.
SUPABASE_DB_URL=
# Your Supabase database password (the one set when you created the project).
# Used by migrate.py when SUPABASE_DB_URL is empty. Either name works.
POSTGRES_PASSWORD=

# --- Token encryption (Fernet) ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# --- Langfuse LLM observability (optional) ---
# When both keys are set, every receipt capture emits a trace showing
# transcribe + parse + Splitwise create as child spans. When unset,
# observability is a no-op and the bot runs unchanged.
# Get keys from your Langfuse dashboard → Settings → API Keys.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Region URL — https://us.cloud.langfuse.com or https://cloud.langfuse.com (EU).
LANGFUSE_HOST=https://us.cloud.langfuse.com

# --- Environment label ---
# Applied as a tag on every Langfuse trace so you can filter dev usage
# from real usage in the dashboard. Conventional values: dev / staging
# / prod. Override per deploy environment. Empty = no environment tag.
ENVIRONMENT=dev
